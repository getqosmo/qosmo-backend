# =============================================================================
# MyBot - example environment file
#
# Copy to .env and edit.  NEVER commit .env.
# Every value below is a placeholder. No real secret belongs in this file.
# =============================================================================

# --- Core ---------------------------------------------------------------
MYBOT_ENV=development                 # development | test | production
MYBOT_LOG_LEVEL=INFO
MYBOT_DATA_DIR=./var                  # local-first state lives here

# --- Database -----------------------------------------------------------
# SQLite is the zero-dependency default and is what `mybot demo` uses.
# For the server profile, point this at Postgres:
#   MYBOT_DATABASE_URL=postgresql+psycopg://mybot:mybot@localhost:5432/mybot
MYBOT_DATABASE_URL=sqlite+pysqlite:///./var/mybot.db

# --- Authentication -----------------------------------------------------
# Signing key for session tokens. Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
# If unset in development a key is generated and stored in MYBOT_DATA_DIR.
# In production the process REFUSES TO START without this set.
MYBOT_JWT_SECRET=
MYBOT_ACCESS_TOKEN_TTL_SECONDS=3600
# How long a "strong" auth elevation lasts before it must be re-proven.
MYBOT_STRONG_AUTH_TTL_SECONDS=300
# How long an approval stays valid before it expires unused.
MYBOT_APPROVAL_TTL_SECONDS=900

# --- Vault --------------------------------------------------------------
# Backend for the master key that encrypts secrets at rest.
#   software  -> key file under MYBOT_DATA_DIR (development default)
#   keyring   -> OS keychain (requires the `keyring` extra)
#   env       -> key supplied via MYBOT_VAULT_MASTER_KEY (containers/CI)
MYBOT_VAULT_KEYSTORE=software
# base64url-encoded 32 bytes. Only read when MYBOT_VAULT_KEYSTORE=env.
MYBOT_VAULT_MASTER_KEY=

# --- LLM ----------------------------------------------------------------
# `mock` is fully deterministic, needs no network and is the default so the
# product boots and demos with zero credentials.
MYBOT_LLM_DEFAULT_PROVIDER=mock
# Per-purpose overrides: classification|extraction|reasoning|planning|summarization|chat
# MYBOT_LLM_PURPOSE_CHAT=anthropic
# MYBOT_LLM_PURPOSE_EXTRACTION=anthropic

ANTHROPIC_API_KEY=
MYBOT_ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
MYBOT_OPENAI_MODEL=gpt-4.1-mini
# Local runtime (Ollama / llama.cpp / MLX) - interface exists, not required to boot.
MYBOT_LOCAL_MODEL_BASE_URL=http://localhost:11434
MYBOT_LOCAL_MODEL=llama3.1

# Redact PII before any prompt leaves this machine.
MYBOT_PII_TOKENIZATION=true
# Hard stop: refuse to call a non-local provider with data above this level.
# PUBLIC|NORMAL|PERSONAL|SENSITIVE|HIGHLY_SENSITIVE|SECRET
MYBOT_MAX_EXTERNAL_CLASSIFICATION=PERSONAL

# --- Integrations -------------------------------------------------------
# Mock connectors are used whenever real credentials are absent.
MYBOT_INTEGRATIONS_MODE=mock          # mock | live
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback

# --- Proactive engine ---------------------------------------------------
MYBOT_PROACTIVE_ENABLED=true
MYBOT_PROACTIVE_INTERVAL_SECONDS=300

# --- Web ----------------------------------------------------------------
MYBOT_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
