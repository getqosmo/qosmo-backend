# --- Required ---
# Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_key

# --- Market data (optional; falls back to sample data if unavailable) ---
# TCG API key (https://tcgapi.dev). Leave blank to use the free/unauthenticated tier.
TCG_API_KEY=
# Override the TCG API base URL if needed.
TCG_API_BASE=https://api.tcgapi.dev/v1
# Force the built-in offline sample dataset (true/false).
USE_SAMPLE_DATA=false

# --- Generation ---
# Claude model used for all content generation.
# NOTE: the original spec referenced "claude-opus-4-20250805", which is not a
# valid model id. The current most-capable Opus is "claude-opus-4-8".
ANTHROPIC_MODEL=claude-opus-4-8
# Max tokens per content piece.
MAX_TOKENS=1500

# --- What to produce ---
# Card games to fetch and analyze.
CARD_CATEGORIES=sports,pokemon,magic
# Platforms to generate content for.
PLATFORMS=reddit,twitter,tiktok,instagram,email,market-analysis

# --- Output ---
OUTPUT_DIR=./content

# --- Automation ---
# Cron schedule for `npm run schedule` (default: 8 AM daily). See https://crontab.guru
SCHEDULE=0 8 * * *

# --- Optional extra delivery ---
# If set, the full batch JSON is also POSTed to this URL after each run.
WEBHOOK_URL=
