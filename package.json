{
  "name": "mybot",
  "private": true,
  "description": "MyBot — repository tooling. The web app lives in apps/web.",
  "type": "module",
  "scripts": {
    "brand": "node scripts/render-brand.mjs",
    "social": "node scripts/render-social.mjs",
    "screens": "node scripts/capture-screens.mjs",
    "site": "node scripts/build-site.mjs",
    "smoke": "node scripts/ui-smoke.mjs",
    "web:dev": "npm --prefix apps/web run dev",
    "web:build": "npm --prefix apps/web run build",
    "web:typecheck": "npm --prefix apps/web run typecheck"
  },
  "devDependencies": {
    "playwright": "^1.56.0"
  }
}
